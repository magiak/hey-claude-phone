{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hey-claude-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "TELEFON", "class_name": "Telefon" }]
  },
  // The Free plan only allows SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Telefon"] }]
}
