{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hey-claude-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "PHONE", "class_name": "Phone" }]
  },
  // The Free plan only allows SQLite-backed Durable Objects.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Telefon"] },
    { "tag": "v2", "renamed_classes": [{ "from": "Telefon", "to": "Phone" }] }
  ]
}
