<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The holder's window (holder/holder.py) hides the notch strip plus 1 mm on the left
         and 1 mm on the other sides, so every inset is counted from the visible edge. -->
    <dimen name="hidden_start">40dp</dimen>
    <dimen name="hidden_edge">6dp</dimen>
    <!-- Hidden part plus 40dp of the visible window. -->
    <dimen name="content_start">80dp</dimen>
    <dimen name="content_edge">46dp</dimen>
    <!-- Shallower than the 40dp to the text: a glow over the text looked ugly (2026-11-09). -->
    <dimen name="glow_depth">30dp</dimen>
</resources>
