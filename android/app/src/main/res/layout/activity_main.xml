<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape, camera notch on the left. One surface fills the holder's window, insets in
     dimens.xml, colours for the light and dark look in colors.xml (Theme.kt picks one). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/content_start"
        android:paddingTop="@dimen/content_edge"
        android:paddingEnd="@dimen/content_edge"
        android:paddingBottom="@dimen/content_edge">

        <!-- As wide as the clock; status and heard wrap under it instead of widening the column. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:textColor="@color/clock"
                android:textSize="100sp" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/muted"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:textColor="@color/status"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/heard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:textColor="@color/faint"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_weight="1"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="22dp"
            android:paddingEnd="24dp"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.03"
                android:textColor="@color/title"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/question"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <!-- Seven lines still fit under a two-line question inside the card and the insets. -->
            <TextView
                android:id="@+id/answer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.15"
                android:maxLines="7"
                android:textColor="@color/text"
                android:textSize="19sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Claude's page (CustomScreen) fills what the holder leaves visible; the gear stays above it. -->
    <FrameLayout
        android:id="@+id/screen_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/hidden_start"
        android:layout_marginTop="@dimen/hidden_edge"
        android:layout_marginEnd="@dimen/hidden_edge"
        android:layout_marginBottom="@dimen/hidden_edge"
        android:visibility="gone" />

    <!-- The page hides the status line, but not what needs his hand (service off, relay down). -->
    <TextView
        android:id="@+id/screen_problem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/content_start"
        android:layout_marginEnd="@dimen/content_edge"
        android:layout_marginBottom="@dimen/content_edge"
        android:background="@drawable/card"
        android:padding="12dp"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- In the strip outside the text insets, so a long answer never runs under it. -->
    <ImageView
        android:id="@+id/settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/hidden_edge"
        android:layout_marginEnd="@dimen/hidden_edge"
        android:alpha="0.6"
        android:contentDescription="Nastavení"
        android:padding="12dp"
        android:src="@drawable/ic_settings"
        android:tint="@color/status" />

    <!-- On top, but not clickable, so taps still reach the root. Padding = what the holder hides. -->
    <cz.magiak.asistent.GlowView
        android:id="@+id/glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/hidden_start"
        android:paddingTop="@dimen/hidden_edge"
        android:paddingEnd="@dimen/hidden_edge"
        android:paddingBottom="@dimen/hidden_edge" />
</FrameLayout>
